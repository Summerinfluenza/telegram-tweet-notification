# Copy to .env for local testing. NEVER commit the real .env.
# In GitHub these go in: Settings > Secrets and variables > Actions.

# X API bearer token (developer console > your app > Keys and tokens)
X_BEARER_TOKEN=REPLACE_ME

# From @BotFather in Telegram
TELEGRAM_BOT_TOKEN=REPLACE_ME

# Your chat id (see README)
TELEGRAM_CHAT_ID=REPLACE_ME

# Comma-separated usernames to watch, without @
X_ACCOUNTS=REPLACE_ME

# Optional (default false)
INCLUDE_REPLIES=false
INCLUDE_REPOSTS=false
