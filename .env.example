# =====================================================================
#  Settings for telegram-tweet-notification
#
#  On the server this file lives at /etc/telegram-tweet-notification.env
#  (install.sh creates it). Replace every REPLACE_ME, then run:
#      sudo /opt/telegram-tweet-notification/deploy/check.sh
#
#  NEVER commit the filled-in version. No quotes needed around values.
# =====================================================================

# --- X (Twitter) ------------------------------------- docs/setup-x.md
# Bearer token from console.x.com > your app > Keys and tokens
X_BEARER_TOKEN=REPLACE_ME

# Usernames to watch, comma-separated, without @ (e.g. nasa,spacex)
X_ACCOUNTS=REPLACE_ME

# Also alert on replies / reposts? (true/false)
INCLUDE_REPLIES=false
INCLUDE_REPOSTS=false

# --- Telegram ---------------------------------- docs/setup-telegram.md
# Token from @BotFather, looks like 123456789:ABCdef...
TELEGRAM_BOT_TOKEN=REPLACE_ME
# Your chat id, a number like 123456789
TELEGRAM_CHAT_ID=REPLACE_ME

# --- AI analysis --------------------------------------- docs/setup-ai.md
# deepseek, gemini, openai, or none (= send posts without analysis)
AI_PROVIDER=none
AI_API_KEY=
# Optional: override the provider's default model
AI_MODEL=

# --- IBKR prices ------------------------------------- docs/setup-ibkr.md
# Needs IB Gateway or TWS running on the server. false = no price levels.
IBKR_ENABLED=true
IBKR_HOST=127.0.0.1
# 4001 = IB Gateway live, 4002 = IB Gateway paper, 7496/7497 = TWS
IBKR_PORT=4001
# Must differ from the client ids your other IBKR scripts use
IBKR_CLIENT_ID=77
# ETFs to analyze in every alert
MARKET_SYMBOLS=QQQ,SPY
