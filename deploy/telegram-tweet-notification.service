[Unit]
Description=Check X accounts and send new posts with analysis to Telegram
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=tweetbot
Group=tweetbot
WorkingDirectory=/opt/telegram-tweet-notification
EnvironmentFile=/etc/telegram-tweet-notification.env
Environment=STATE_FILE=/var/lib/telegram-tweet-notification/state.json
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/telegram-tweet-notification/.venv/bin/python -m notifier.main
# AI calls can take a while when several posts arrive at once.
TimeoutStartSec=300

# Hardening: the bot only needs the network and its state folder.
ReadWritePaths=/var/lib/telegram-tweet-notification
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
